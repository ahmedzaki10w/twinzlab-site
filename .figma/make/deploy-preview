#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/deploy-preview-static"

npm run build
rm -rf "$build_dir"
mkdir -p "$build_dir"
cp -R about admin assets contact lab products "$build_dir/"
cp index.html f2c-sw.js interactions.css interactions.js preloader.css preloader.js \
  responsive.css responsive.js robots.txt signup.js sitemap.xml "$build_dir/"

[[ -d "$build_dir" ]] || {
  echo "Expected build output at $build_dir" >&2
  exit 1
}
figma make deploy-preview --build-dir "$build_dir"
